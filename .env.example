# Quickstart: cp .env.example .env → set OPENAI_API_KEY → make deps → make up → make demo (~15 min). See README.
POSTGRES_USER=docwise
POSTGRES_PASSWORD=change_this_in_prod
POSTGRES_DB=docwise_db
DATABASE_URL=postgresql://docwise:change_this_in_prod@postgres:5432/docwise_db
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=docwise
S3_SECRET_KEY=change_this_in_prod
S3_BUCKET=documents
EMBEDDING_MODEL_PATH=/app/.models
MINIO_ROOT_USER=docwise
MINIO_ROOT_PASSWORD=change_this_in_prod
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change_this_secret_key_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
GOOGLE_CLIENT_ID=
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
OPENAI_API_KEY=
# KodikRouter (https://kodikrouter.ru/keys): ключ sk-kr_* / kdk_* сам выбирает шлюз.
# Или явно:
# OPENAI_BASE_URL=https://api.kodikrouter.ru/v1
# OPENAI_MODEL=openai/gpt-4o-mini
SENTRY_DSN=
RATE_LIMIT_UPLOAD_PER_MINUTE=10
UPLOAD_MAX_BYTES=52428800
RATE_LIMIT_CHAT_PER_MINUTE=30
RERANK_THRESHOLD=0.25
RATE_LIMIT_AUTH_PER_MINUTE=20
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# SPA на :3001 → API :8001: SameSite=None; Secure (localhost — secure context).
COOKIE_SAMESITE=none
COOKIE_SECURE=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
# Plan quotas (M6a). New org is starter. Numbers match docs/platform/billing.md.
PLAN_PERIOD_DAYS=30
PLAN_STARTER_SEATS=3
PLAN_STARTER_PAGES=200
PLAN_STARTER_TOKENS=100000
PLAN_TEAM_SEATS=15
PLAN_TEAM_PAGES=2000
PLAN_TEAM_TOKENS=1000000
PLAN_ENTERPRISE_SEATS=100
PLAN_ENTERPRISE_PAGES=20000
PLAN_ENTERPRISE_TOKENS=10000000
# Billing port (M6b). Compose and non-production default is dev — do not call Stripe.
BILLING_PROVIDER=dev
# SSO (M6c). Compose default is a fixture assertion, not live Okta.
SSO_PROVIDER=dev
# Custom domain (M6d). Platform `{slug}.localhost` / `{slug}.docwise.app`. Compose: /etc/hosts, no Let's Encrypt.
PLATFORM_HOST_SUFFIXES=localhost,docwise.app
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_TEAM=
# STRIPE_PRICE_ENTERPRISE=
# FRONTEND_URL=http://localhost:3001
# Admin inspect (`POST /api/v1/search/inspect`). Off by default when ENVIRONMENT=production.
# Compose sets ENABLE_SEARCH_INSPECT=true unless you override.
ENABLE_SEARCH_INSPECT=true
# Корпоративный прокси (как у curl: https_proxy). Docker extra_hosts на IP прокси ломает Kodik.
# HTTPS_PROXY=http://130.100.7.223:5000
# HTTP_PROXY=http://130.100.7.223:5000
# NO_PROXY=localhost,127.0.0.1,postgres,redis,minio

# Public demo profile — see docs/portfolio/deploy-public-demo.md
# ENVIRONMENT=production
# FRONTEND_URL=https://demo.yourdomain.com
# CORS_ORIGINS=https://demo.yourdomain.com
# ENABLE_SEARCH_INSPECT=false
# NEXT_PUBLIC_SHOW_DEMO_LOGINS=true   # frontend build arg / compose env for frontend service
# RATE_LIMIT_CHAT_PER_MINUTE=15
# RATE_LIMIT_AUTH_PER_MINUTE=10
